{
	"name": "@standard-config/template",
	"version": "0.0.0",
	"description": "Use this template to create a Standard Config package",
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/standard-config/template.git"
	},
	"keywords": [
		"package",
		"template"
	],
	"files": [
		"dist/**"
	],
	"type": "module",
	"sideEffects": false,
	"exports": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.28.2",
	"devDependencies": {
		"@standard-config/eslint": "1.3.0",
		"@standard-config/oxlint": "1.0.1",
		"@standard-config/prettier": "1.8.1",
		"@standard-config/tsconfig": "2.0.2",
		"@types/node": "^22.19.9",
		"@vitest/coverage-v8": "4.0.18",
		"eslint": "9.39.2",
		"husky": "9.1.7",
		"jiti": "2.6.1",
		"oxlint": "1.43.0",
		"oxlint-tsgolint": "0.11.4",
		"prettier": "3.8.1",
		"publint": "0.3.17",
		"tsdown": "0.20.1",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"scripts": {
		"build": "tsdown",
		"fix": "pnpm format && pnpm lint && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint": "oxlint --fix --report-unused-disable-directives --type-aware --type-check && eslint --fix .",
		"lint:check": "oxlint --deny-warnings --report-unused-disable-directives --type-aware --type-check && eslint .",
		"prepack": "pnpm run '/^(format:check|lint:check|test|typecheck)$/' && pnpm build",
		"prepare": "husky",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	}
}
