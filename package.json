{
	"name": "@standard-config/template",
	"version": "0.0.0",
	"description": "Standard Config package template",
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"homepage": "https://sconfig.org/template",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/standard-config/template.git"
	},
	"keywords": [
		"package",
		"standard-config"
	],
	"files": [
		"dist/**"
	],
	"type": "module",
	"sideEffects": false,
	"exports": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.9.0",
	"devDependencies": {
		"@standard-config/oxlint": "^2.2.2",
		"@standard-config/oxlint-stylistic": "^2.2.2",
		"@standard-config/prettier": "^1.13.3",
		"@standard-config/tsconfig": "^3.2.0",
		"@vitest/coverage-v8": "4.1.9",
		"eslint": "^10.6.0",
		"prettier": "^3.9.0",
		"publint": "^0.3.21",
		"typescript": "^6.0.3",
		"vite-plus": "^0.2.1"
	},
	"scripts": {
		"build": "vp pack",
		"fix": "pnpm format && pnpm lint && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint": "vp lint --fix",
		"lint:check": "vp lint --deny-warnings --type-check",
		"prepack": "pnpm run '/^(format:check|lint:check|test|typecheck)$/' && pnpm build",
		"prepare": "vp config",
		"test": "vp test",
		"typecheck": "tsc --noEmit"
	}
}
